# Secret used to sign session cookies (32+ random bytes). Never commit real values.
SESSION_SECRET=replace-with-32-random-bytes
# Production: a hosted Postgres connection string (e.g. Neon via Vercel Storage). When set, PGlite is not used.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Folder for the embedded Postgres (PGlite) database used in local development.
DATABASE_DIR=./.data/pglite
# Timezone used to display dates.
APP_TIMEZONE=Asia/Dhaka
# Shows the "demo: advance status" control on donation details (until NGO/Volunteer portals exist).
DEMO_MODE=true
# Protects GET /api/cron/housekeeping (expiry + matching). 16+ characters. Call it on a schedule in production.
CRON_SECRET=replace-with-a-long-random-string
# First admin account. Required for a production start (NODE_ENV=production without DEMO_MODE).
# ADMIN_EMAIL=admin@your-domain.org
# ADMIN_PASSWORD=use-a-long-unique-password

# --- Maps (Segment 12). Optional: tile server for Leaflet maps (defaults to public OpenStreetMap).
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# --- Outside notification channels (Segment 14). Optional: each posts JSON to a webhook/bridge.
# NOTIFY_EMAIL_WEBHOOK_URL=
# NOTIFY_SMS_WEBHOOK_URL=
# NOTIFY_WHATSAPP_WEBHOOK_URL=
# NOTIFY_MESSENGER_WEBHOOK_URL=
# NOTIFY_WEBHOOK_TOKEN=

# --- AI assistant (Segment 15). Set at least one key; without any the assistant runs in help mode (no AI).
# Providers are tried in this order; if one is busy or fails, the next one answers.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest,gemini-2.5-flash
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5
# AI_EFFORT=low

# --- WhatsApp / Messenger via n8n (Segment 17). See integrations/n8n/README.md. Off until INTEGRATION_SECRET is set.
# INTEGRATION_SECRET=replace-with-16+-random-characters
# NEXT_PUBLIC_WHATSAPP_NUMBER=8801XXXXXXXXX
# NEXT_PUBLIC_MESSENGER_PAGE=your-page-username
# APP_URL=https://foodbridge.example
